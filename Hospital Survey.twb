      <column caption='Top Box' datatype='integer' name='[Calculation_0448907312373760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If CONTAINS([hcahps_question],&apos;Always&apos;) or CONTAINS([hcahps_question],&apos;9&apos;)&#10;then 1 else 0&#10;END' />
      </column>
      <column caption='Actual Hcahps Answer Percent' datatype='real' name='[Calculation_0448907314700289]' role='measure' type='quantitative'>
