      </column>
      <column caption='Hospital Size' datatype='string' name='[Calculation_3690542522507264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [number_of_beds] &gt;= 500 then &apos;Large&apos;&#10;&#10;ELSEIF  [number_of_beds] &gt;= 100 and [number_of_beds] &lt; 500 then &apos;Medium&apos;&#10;&#10;ELSEIF  [number_of_beds] &lt; 100 then &apos;Small&apos;&#10;&#10;END' />
      </column>
      <column caption='Hospital Complete Name' datatype='string' name='[Calculation_3690542533910530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[facility_name] + &apos; - &apos; + STR([provider_ccn])' />
      </column>
      <column caption='Question Delta from Mean Cohort' datatype='real' name='[Calculation_3690542543761411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0448907314700289] - { FIXED [state],[Calculation_3690542522507264],[hcahps_answer_description]: AVG([Calculation_0448907314700289]) }' />
      </column>
      <column caption='Actual Survey Response Rate Percent ' datatype='real' name='[Calculation_4412578778750976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[survey_response_rate_percent] /100' />
      </column>
      <column caption='Hospital Check' datatype='boolean' name='[Calculation_4412578788433922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3690542533910530] = [Parameters].[Parameter 4412578787737601]' />
      </column>
      <column caption='Color' datatype='string' name='[Calculation_4412578796916739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4412578788433922] = TRUE&#10;THEN if [Calculation_3690542543761411] &lt; 0 THEN &apos;Negative&apos;&#10;ELSEIF [Calculation_3690542543761411] &gt;= 0 THEN &apos;Positive&apos;END&#10;END' />
      </column>
